<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>KansScripts</AssemblyName>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- An offline restore cannot fetch vulnerability data; reported vulnerabilities (NU1901-NU1904) stay errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2*;IL3*</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(KansScriptProject)" />
    <ProjectReference Include="../KansScriptCore/KansScriptCore.csproj" />
  </ItemGroup>
</Project>
