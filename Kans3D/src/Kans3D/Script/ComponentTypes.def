// Stable ABI IDs. Retired IDs must never be reused. MaterialComponent is a legacy API with no native component.
KANS_COMPONENT(1, TransformComponent)
KANS_COMPONENT(2, MaterialComponent)
KANS_COMPONENT(3, CameraComponent)
KANS_COMPONENT(4, ScriptComponent)
KANS_COMPONENT(5, TextComponent)
KANS_COMPONENT(6, SpriteRendererComponent)
KANS_COMPONENT(7, UIScreenComponent)
KANS_COMPONENT(8, UIWorldComponent)
