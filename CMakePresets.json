{
    "version": 3,
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "description": "Settings shared by all configurations",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;Dist",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-common",
            "hidden": true,
            "description": "Linux: Ninja Multi-Config generator",
            "inherits": "common",
            "generator": "Ninja Multi-Config",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux GCC",
            "description": "Build with GCC on Linux",
            "inherits": "linux-common",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux Clang",
            "description": "Build with Clang on Linux",
            "inherits": "linux-common",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "windows-common",
            "hidden": true,
            "description": "Windows: Visual Studio 2022, x64",
            "inherits": "common",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows MSVC",
            "description": "Build with MSVC (cl.exe) on Windows",
            "inherits": "windows-common",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "windows-clang",
            "displayName": "Windows Clang (clang-cl)",
            "description": "Build with Clang (clang-cl) on Windows",
            "inherits": "windows-common",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-clang-x64"
                }
            }
        },
        {
            "name": "windows-clangd",
            "displayName": "Windows Ninja (compile_commands only)",
            "description": "Single-config Ninja build to generate compile_commands.json for clangd",
            "inherits": "windows-common",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-gcc-debug",
            "displayName": "Debug",
            "configurePreset": "linux-gcc",
            "configuration": "Debug"
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Release",
            "configurePreset": "linux-gcc",
            "configuration": "Release"
        },
        {
            "name": "linux-gcc-dist",
            "displayName": "Dist",
            "configurePreset": "linux-gcc",
            "configuration": "Dist"
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Debug",
            "configurePreset": "linux-clang",
            "configuration": "Debug"
        },
        {
            "name": "linux-clang-release",
            "displayName": "Release",
            "configurePreset": "linux-clang",
            "configuration": "Release"
        },
        {
            "name": "linux-clang-dist",
            "displayName": "Dist",
            "configurePreset": "linux-clang",
            "configuration": "Dist"
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Debug",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Release",
            "configurePreset": "windows-msvc",
            "configuration": "Release"
        },
        {
            "name": "windows-msvc-dist",
            "displayName": "Dist",
            "configurePreset": "windows-msvc",
            "configuration": "Dist"
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Debug",
            "configurePreset": "windows-clang",
            "configuration": "Debug"
        },
        {
            "name": "windows-clang-release",
            "displayName": "Release",
            "configurePreset": "windows-clang",
            "configuration": "Release"
        },
        {
            "name": "windows-clang-dist",
            "displayName": "Dist",
            "configurePreset": "windows-clang",
            "configuration": "Dist"
        }
    ]
}
